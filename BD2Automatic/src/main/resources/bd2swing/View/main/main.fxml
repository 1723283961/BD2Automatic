<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cn.kutori.bd2swing.Main.Controller.MainController">

    <!-- 顶部目录 -->
    <top>
        <HBox spacing="0" alignment="CENTER_LEFT" styleClass="top-bar">
            <Button text="兑换" onAction="#showExchange"/>
            <Button text="记录" onAction="#showHistory"/>
        </HBox>
    </top>

    <!-- 左侧快捷兑换 -->
    <left>
        <VBox spacing="10" styleClass="side-bar">
            <Label text="快捷兑换"/>
            <ListView fx:id="quickList"/>
            <Button text="一键兑换" onAction="#quickExchange"/>
        </VBox>
    </left>

    <!-- 中央内容区（切换） -->
<!--    <center fx:id="contentPane"/>-->


</BorderPane>
